# Only the files needed to rebuild the driver, rerun the pipeline and the tests, and redraw the paper's figures are
# tracked (see README.md). Everything else here (third-party sources, builds, raw driver output) is ignored.
/*
!/.gitignore
!/README.md
!/AUTHORS
!/report/
!/energy/
!/eigen/

/report/*
!/report/report.tex
!/report/references.bib
!/report/report.pdf
!/report/figures/
/report/figures/*
!/report/figures/make_figures.py
!/report/figures/*.pdf

/energy/*
!/energy/*.py
/energy/build_report.py
/energy/heat.py
!/energy/data/
/energy/data/*
!/energy/data/mathlib_env.tsv.gz
!/energy/data/out/
/energy/data/out/*
!/energy/data/out/projects.csv
!/energy/data/out/projects_ai.csv
!/energy/data/out/areas.csv
!/energy/data/out/tests.csv
!/energy/data/out/summary.json
!/energy/data/out/group_metrics.csv
!/energy/data/out/pooled.csv
!/energy/data/out/corr_openai.csv
!/energy/data/out/decomp.json

/eigen/*
!/eigen/driver/
/eigen/driver/.lake/
!/eigen/jobs/
/eigen/jobs/local/
!/eigen/tests/
/eigen/tests/terms_toy/out/
!/eigen/human_reachable.json
!/eigen/mathlib_thm_names.txt
!/eigen/run_driver.sh
!/eigen/run_all.sh
!/eigen/run_analyses.sh
!/eigen/analyze.py
!/eigen/gloss.py
!/eigen/stats_eigen.py
!/eigen/stats_corpora.py
!/eigen/cuts_prelim.py
!/eigen/cuts_exact.py
!/eigen/recheck_cuts.py
!/eigen/recheck_ep.py
!/eigen/strip_study.py
!/eigen/tactic_mix.py
!/eigen/terms_analysis.py
!/eigen/terms_extra.py
!/eigen/compare_iso.py
!/eigen/chk_ladder.py
!/eigen/lean3job.py
!/eigen/run_stream.py
!/eigen/run_isolated.py
!/eigen/link_outputs.py
!/eigen/localize_jobs.py
# result files behind the paper's tables and figures
!/eigen/out_final/
/eigen/out_final/*
!/eigen/out_final/tactic_mix.json
!/eigen/out_final/iso_compare.json
!/eigen/out_final/analysis*/
/eigen/out_final/analysis*/*
!/eigen/out_final/analysis*/results.json
!/eigen/out_final/analysis_all/corpora.json
!/eigen/out_final/analysis_merged/recheck_ep.json
/eigen/out_final/analysis_repro/
/eigen/out_final/analysis_all/results.json
!/eigen/out_cut/
/eigen/out_cut/*
!/eigen/out_cut/results_ai.json
!/eigen/out_cut/report_cuts_ai.json
!/eigen/out_terms/
/eigen/out_terms/*
!/eigen/out_terms/terms_results.json
!/eigen/out_terms/terms_extra_mathlib.json
!/eigen/out_ai_ready/
/eigen/out_ai_ready/*
!/eigen/out_ai_ready/failures.json

.DS_Store
__pycache__/
*.pyc
